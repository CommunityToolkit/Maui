# Environment variables shared by the workflows in this folder (dotnet-build.yml, device-tests.yml, benchmarks.yml and
# dotnet-format-daily.yml). Each job that uses them loads this file right after its checkout:
#
#     -   name: Load shared environment variables
#         uses: ./.github/actions/load-shared-env
#
# and its later steps read them as ${{ env.NAME }}. They are not available in runs-on, a job's if or a matrix.
# Format: NAME=value, one per line, no quotes; lines starting with # are comments.

# Builds, tests and packs the library; runs the Android and Windows device tests and merges the code coverage reports.
TOOLKIT_NET_VERSION=10.0.100

# The latest feature band: builds the sample and runs the iOS and Mac Catalyst device tests, whose apps build against the Xcode SDK of
# CommunityToolkitSample_Xcode_Version, which the workload packs of the latest feature band support (not those of TOOLKIT_NET_VERSION).
LATEST_NET_VERSION=10.0.x

# Xcode of the library build (macOS).
CommunityToolkitLibrary_Xcode_Version=26.1

# Xcode of the sample build and of the iOS and Mac Catalyst device tests.
CommunityToolkitSample_Xcode_Version=27.0
