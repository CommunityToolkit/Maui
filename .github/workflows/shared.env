# Each job that uses these variables loads this file right after its checkout:
#
#     -   name: Load shared environment variables
#         uses: ./.github/actions/load-shared-env
#
# and its later steps read them as ${{ env.NAME }}. They are not available in runs-on, a job's if or a matrix.
# Write NAME=value without quotes: the value is used as written.

TOOLKIT_NET_VERSION=10.0.100

# The sample and the iOS and Mac Catalyst device tests build against the Xcode SDK of CommunityToolkitSample_Xcode_Version, which the
# workload packs of the latest feature band support (not those of TOOLKIT_NET_VERSION).
LATEST_NET_VERSION=10.0.x

CommunityToolkitLibrary_Xcode_Version=26.1

CommunityToolkitSample_Xcode_Version=27.0
