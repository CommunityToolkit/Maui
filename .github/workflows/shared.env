# Each job that uses these variables loads this file right after its checkout:
#
#     -   name: Load shared environment variables
#         uses: ./.github/actions/load-shared-env
#
# and its later steps read them as ${{ env.NAME }}. They are not available in runs-on, a job's if or a matrix.
# Write NAME=value without quotes: the value is used as written.

TOOLKIT_NET_VERSION=11.0.100

# The sample and the iOS and Mac Catalyst device tests build with the latest .NET SDK; the sample also builds with the latest .NET MAUI release.
LATEST_NET_VERSION=11.0.x

# The .NET 11 macios workload packs build apps only with the Xcode major.minor they were made for (E0191), so these are exact Xcode versions.
# ensure-ci-always-tests-latest-operating-systems.yml sets both values each night from the newest workload sets, once the xcode-NN
# image has that Xcode as a GA release. An Xcode that only a newer xcode-NN image has goes to the bot's issue as a patch instead.
# The library value follows the newest workload set of the band the library builds with: TOOLKIT_NET_VERSION's, or a newer band of that
# .NET version that the xcode-NN image preinstalls (global.json rolls forward). Build Library also builds the Sample for iOS (trim
# audit), so it must match what that band's iOS workload requires (E0191).
CommunityToolkitLibrary_Xcode_Version=27.2

# The sample value follows the newest workload set of the band of the newest SDK that LATEST_NET_VERSION installs. The iOS and Mac Catalyst
# device tests use it too.
CommunityToolkitSample_Xcode_Version=27.2
