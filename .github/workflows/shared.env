# Each job that uses these variables loads this file right after its checkout:
#
#     -   name: Load shared environment variables
#         uses: ./.github/actions/load-shared-env
#
# and its later steps read them as ${{ env.NAME }}. They are not available in runs-on, a job's if or a matrix.
# Write NAME=value without quotes: the value is used as written.

TOOLKIT_NET_VERSION=11.0.100

# The sample and the iOS and Mac Catalyst device tests build with the latest .NET SDK and the latest .NET MAUI release.
LATEST_NET_VERSION=11.0.x

# The .NET 11 macios workload packs build apps only with the Xcode major.minor they were made for (E0191), so these are exact Xcode versions.
# The library builds with TOOLKIT_NET_VERSION, so its Xcode version stays pinned.
# Build Library also builds the Sample for iOS (trim audit), so this must match the Xcode version
# that TOOLKIT_NET_VERSION's iOS workload requires (E0191).
CommunityToolkitLibrary_Xcode_Version=27.2

# Keep this in sync with the Xcode version that the latest .NET MAUI release requires.
CommunityToolkitSample_Xcode_Version=27.2
