# Vendored from dotnet/maui (see README.md). Treated as generated code so the repository's style analyzers do not
# rewrite upstream code, which keeps it diffable against dotnet/maui. Compiler diagnostics still apply.
[*.cs]
generated_code = true

# Toolkit code, not vendored (see the header of each file): the repository's analyzers apply.
[{HeadlessRunner/windows/TestRunLog.cs,TestApplicationDispatcher.cs,CoverageRecorder.cs}]
generated_code = false
