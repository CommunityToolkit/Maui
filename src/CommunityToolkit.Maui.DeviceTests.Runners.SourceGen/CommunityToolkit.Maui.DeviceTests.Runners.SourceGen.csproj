<Project Sdk="Microsoft.NET.Sdk">

  <!-- dotnet/maui's runner source generator, vendored: see ../CommunityToolkit.Maui.DeviceTests.Runners/README.md.
       It generates each device-test app's platform entry points (Android MainApplication/MainActivity/TestActivity/
       TestInstrumentation, iOS and Mac Catalyst Program + app delegates) from ApplicationId, ApplicationTitle and RootNamespace. -->

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsRoslynComponent>true</IsRoslynComponent>
    <RootNamespace>CommunityToolkit.Maui.DeviceTests.Runners.SourceGen</RootNamespace>
    <AssemblyName>CommunityToolkit.Maui.DeviceTests.Runners.SourceGen</AssemblyName>
    <!-- RS2002: TST1001 is the generator's Debug-only logging diagnostic, so no analyzer lists it as supported (as upstream). -->
    <NoWarn>$(NoWarn);RS2002</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.5.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

</Project>
