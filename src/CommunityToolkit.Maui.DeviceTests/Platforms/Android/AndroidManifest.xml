<?xml version="1.0" encoding="utf-8"?>
<!-- The runner source generator declares the activities and the <ApplicationId>.TestInstrumentation instrumentation. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
	<!-- usesCleartextTraffic: the Android MediaElement tests download media and artwork from an HTTP server on the device's loopback interface (LoopbackHttpServer), and Android blocks cleartext HTTP by default. -->
	<application android:allowBackup="true" android:icon="@mipmap/appicon" android:roundIcon="@mipmap/appicon_round" android:supportsRtl="true" android:usesCleartextTraffic="true"></application>

	<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
	<uses-permission android:name="android.permission.INTERNET" />
	<!-- SpeechToText, and CameraView records its videos with audio. -->
	<uses-permission android:name="android.permission.RECORD_AUDIO" />
	<uses-permission android:name="android.permission.CAMERA" />
	<!-- The tests that enable MediaElement's foreground service (UseMauiCommunityToolkitMediaElement(isAndroidForegroundServiceEnabled: true)) need the permissions below. -->
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
	<uses-permission android:name="android.permission.MEDIA_CONTENT_CONTROL" />
	<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
	<!-- Emulators without a camera must still install the app. -->
	<uses-feature android:name="android.hardware.camera" android:required="false" />
	<uses-feature android:name="android.hardware.camera.any" android:required="false" />

	<queries>
		<!-- SpeechToText: makes the speech recognition service visible from Android 11 (package visibility). -->
		<intent>
			<action android:name="android.speech.RecognitionService" />
		</intent>
	</queries>
</manifest>
