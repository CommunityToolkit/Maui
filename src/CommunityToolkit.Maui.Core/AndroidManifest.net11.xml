<?xml version="1.0" encoding="utf-8"?>
<!--
  - package: the build leaves a library manifest without a package attribute out of the .aar.
  - uses-sdk: for a library manifest without it the manifest merger assumes API level 1 and adds the implied READ_PHONE_STATE,
    READ_EXTERNAL_STORAGE and WRITE_EXTERNAL_STORAGE permissions to the manifest of every app that references CommunityToolkit.Maui.Core.
    The Android build requires minSdkVersion to equal the Android SupportedOSPlatformVersion of CommunityToolkit.Maui.Core.csproj for the
    NetVersion it builds: 24 for .NET 11 (this file, which the project uses for NetVersion net11.0), 21 for .NET 10 (AndroidManifest.xml).
    Keep both files the same otherwise.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="communitytoolkit.maui.core">
  <uses-sdk android:minSdkVersion="24" />

  <queries>
    <!-- Badge: from Android 11 (package visibility) BadgeFactory can only resolve the launcher from the HOME intent when the app declares this query. -->
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.HOME" />
    </intent>
  </queries>
</manifest>
