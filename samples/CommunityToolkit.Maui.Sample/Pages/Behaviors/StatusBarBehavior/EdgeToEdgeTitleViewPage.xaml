<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CommunityToolkit.Maui.Sample.Pages.Behaviors.EdgeToEdgeTitleViewPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:xct="clr-namespace:CommunityToolkit.Maui.Behaviors;assembly=CommunityToolkit.Maui">

    <Page.Behaviors>
        <xct:StatusBarBehavior StatusBarStyle="LightContent" />
    </Page.Behaviors>

    <ScrollView>
        <VerticalStackLayout>

            <Grid
                BackgroundColor="{StaticResource StatusbarColor}"
                HeightRequest="56"
                Padding="16,0">
                <Label
                    HorizontalOptions="Center"
                    Text="Edge-to-Edge TitleView"
                    TextColor="White"
                    VerticalOptions="Center"
                    FontAttributes="Bold"
                    FontSize="18" />
            </Grid>

            <VerticalStackLayout
                Padding="20,16"
                Spacing="24">

                <Label
                    Style="{StaticResource LabelSectionTitle}"
                    Text="Edge-to-Edge TitleView" />

                <Label
                    Style="{StaticResource LabelSectionText}"
                    LineBreakMode="WordWrap"
                    Text="This page is presented as a modal and is drawn edge-to-edge, reaching all the way under the status bar. This is a regression test for #2351: before the fix, the default transparent status bar color pushed the content behind the system bars; with the fix, the content stays edge-to-edge while the StatusBarBehavior keeps the status bar styled correctly." />

                <Border Style="{StaticResource BorderGalleryCard}">
                    <VerticalStackLayout Spacing="12">
                        <Label
                            FontAttributes="Bold"
                            Text="Status bar color" />
                        <Label
                            LineBreakMode="WordWrap"
                            Text="Toggle to switch the status bar color between blue and red. This confirms the StatusBarBehavior is applying the color while the content stays edge-to-edge under the status bar in both states." />
                        <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                            <Label
                                Text="Blue  ↔  Red"
                                VerticalOptions="Center" />
                            <Switch
                                x:Name="StatusColorSwitch"
                                SemanticProperties.Description="Use a red status bar"
                                Toggled="OnStatusColorSwitchToggled" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Button
                    Clicked="OnBackButtonClicked"
                    HorizontalOptions="Center"
                    Text="Back to StatusBarBehavior demo" />

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
