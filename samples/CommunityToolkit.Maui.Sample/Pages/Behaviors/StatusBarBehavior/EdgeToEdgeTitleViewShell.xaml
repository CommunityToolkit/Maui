<?xml version="1.0" encoding="UTF-8" ?>

<Shell
    Shell.FlyoutBehavior="Disabled"
    Shell.TabBarForegroundColor="{AppThemeBinding Light={StaticResource NavBarColor}, Dark={StaticResource White}}"
    Shell.TabBarTitleColor="{AppThemeBinding Light={StaticResource NavBarColor}, Dark={StaticResource White}}"
    Title="Edge-to-Edge Shell"
    x:Class="CommunityToolkit.Maui.Sample.Pages.Behaviors.EdgeToEdgeTitleViewShell"
    x:DataType="vm:EdgeToEdgeShellViewModel"
    x:Name="DemoShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:mct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:pages="clr-namespace:CommunityToolkit.Maui.Sample.Pages.Behaviors"
    xmlns:vm="clr-namespace:CommunityToolkit.Maui.Sample.ViewModels.Behaviors"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Shell.Behaviors>
        <mct:StatusBarBehavior
            BindingContext="{Binding Path=BindingContext, Source={x:Reference DemoShell}, x:DataType=Shell}"
            StatusBarColor="{Binding StatusBarColor}"
            StatusBarStyle="LightContent" />
    </Shell.Behaviors>

    <TabBar>
        <Tab Title="Tab 1">
            <ShellContent ContentTemplate="{DataTemplate pages:EdgeToEdgeTitleViewPage}" />
        </Tab>
        <Tab Title="Tab 2">
            <ShellContent ContentTemplate="{DataTemplate pages:EdgeToEdgeTitleViewPage}" />
        </Tab>
    </TabBar>
</Shell>