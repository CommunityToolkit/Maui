<?xml version="1.0" encoding="utf-8" ?>
<pages:BasePage
    x:Class="CommunityToolkit.Maui.Sample.Pages.Behaviors.AnimationBehaviorPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:behaviorPages="clr-namespace:CommunityToolkit.Maui.Sample.Pages.Behaviors"
    xmlns:mct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:pages="clr-namespace:CommunityToolkit.Maui.Sample.Pages"
    xmlns:system="clr-namespace:System;assembly=netstandard"
    xmlns:vm="clr-namespace:CommunityToolkit.Maui.Sample.ViewModels.Behaviors"
    Padding="0"
    x:DataType="vm:AnimationBehaviorViewModel"
    x:TypeArguments="vm:AnimationBehaviorViewModel">

    <!--  A ScrollView clips its content to its bounds, so it fills the page (Padding="0" above) and the scale animations below are not cut off at its edges  -->
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="15">
            <Label>
                <Label.FormattedText>
                    <FormattedString>
                        <FormattedString.Spans>
                            <Span Text="AnimationBehavior is a Behavior that can be attached to any VisualElement, allowing developers to: trigger animations via: ICommand AnimateCommand." />
                            <Span Text="{x:Static system:Environment.NewLine}" />
                            <Span Text="* set AnimateOnTap to add a TapGestureRecognizer to the attached VisualElement" />
                            <Span Text="{x:Static system:Environment.NewLine}" />
                            <Span Text="* define an EventName that will trigger the animation" />
                            <Span Text="{x:Static system:Environment.NewLine}" />
                            <Span Text="* trigger the animation through the AnimateCommand property" />
                        </FormattedString.Spans>
                    </FormattedString>
                </Label.FormattedText>
            </Label>

            <Button Margin="16,0" Text="Click this Button">
                <Button.Behaviors>
                    <mct:AnimationBehavior EventName="Clicked">
                        <mct:AnimationBehavior.AnimationType>
                            <behaviorPages:SampleScaleAnimation Easing="{x:Static Easing.Linear}" Length="100" />
                        </mct:AnimationBehavior.AnimationType>
                    </mct:AnimationBehavior>
                </Button.Behaviors>
            </Button>

            <Entry Margin="16,0" Placeholder="Animate on Focused and Unfocused">
                <Entry.Behaviors>
                    <mct:AnimationBehavior EventName="Focused">
                        <mct:AnimationBehavior.AnimationType>
                            <behaviorPages:SampleScaleToAnimation
                                Easing="{x:Static Easing.Linear}"
                                Length="100"
                                Scale="1.05" />
                        </mct:AnimationBehavior.AnimationType>
                    </mct:AnimationBehavior>

                    <mct:AnimationBehavior EventName="Unfocused">
                        <mct:AnimationBehavior.AnimationType>
                            <behaviorPages:SampleScaleToAnimation
                                Easing="{x:Static Easing.Linear}"
                                Length="100"
                                Scale="1" />
                        </mct:AnimationBehavior.AnimationType>
                    </mct:AnimationBehavior>
                </Entry.Behaviors>
            </Entry>

            <Entry Margin="16,0" Placeholder="Animate on tap">
                <Entry.Behaviors>
                    <mct:AnimationBehavior AnimateOnTap="{Binding Source={x:Reference AnimateOnTapToggle}, Path=IsToggled, x:DataType=Switch}">
                        <mct:AnimationBehavior.AnimationType>
                            <behaviorPages:SampleScaleAnimation Easing="{x:Static Easing.Linear}" Length="100" />
                        </mct:AnimationBehavior.AnimationType>
                    </mct:AnimationBehavior>
                </Entry.Behaviors>
            </Entry>
            <HorizontalStackLayout Margin="16,0" Spacing="10">
                <Label Text="Toggle animate on tap: " VerticalTextAlignment="Center" />
                <Switch x:Name="AnimateOnTapToggle" />
            </HorizontalStackLayout>

            <Border BackgroundColor="LightGreen" Margin="16,0">
                <Border.Behaviors>
                    <mct:AnimationBehavior AnimateOnTap="True">
                        <mct:AnimationBehavior.AnimationType>
                            <mct:FlipHorizontalAnimation />
                        </mct:AnimationBehavior.AnimationType>
                    </mct:AnimationBehavior>
                </Border.Behaviors>
                <Label HorizontalOptions="Center" Text="Click to Flip this Border horizontally" TextColor="Black" />
            </Border>

            <Border BackgroundColor="LightGreen" Margin="16,0">
                <Border.Behaviors>
                    <mct:AnimationBehavior AnimateOnTap="True">
                        <mct:AnimationBehavior.AnimationType>
                            <mct:FlipVerticalAnimation />
                        </mct:AnimationBehavior.AnimationType>
                    </mct:AnimationBehavior>
                </Border.Behaviors>
                <Label HorizontalOptions="Center" Text="Click to Flip this Border vertically" TextColor="Black" />
            </Border>

            <Border BackgroundColor="LightGreen" Margin="16,0">
                <Border.Behaviors>
                    <mct:AnimationBehavior AnimateOnTap="True">
                        <mct:AnimationBehavior.AnimationType>
                            <mct:RotateAnimation Rotation="360" />
                        </mct:AnimationBehavior.AnimationType>
                    </mct:AnimationBehavior>
                </Border.Behaviors>
                <Label HorizontalOptions="Center" Text="Click to Rotate this Border 360 degrees" TextColor="Black" />
            </Border>

            <Border BackgroundColor="LightGreen" Margin="16,0">
                <Border.Behaviors>
                    <mct:AnimationBehavior AnimateOnTap="True">
                        <mct:AnimationBehavior.AnimationType>
                            <mct:ScaleAnimation />
                        </mct:AnimationBehavior.AnimationType>
                    </mct:AnimationBehavior>
                </Border.Behaviors>
                <Label HorizontalOptions="Center" Text="Click to Scale this Border" TextColor="Black" />
            </Border>

            <Border BackgroundColor="LightGreen" Margin="16,0">
                <Border.Behaviors>
                    <mct:AnimationBehavior AnimateOnTap="True">
                        <mct:AnimationBehavior.AnimationType>
                            <mct:ShakeAnimation />
                        </mct:AnimationBehavior.AnimationType>
                    </mct:AnimationBehavior>
                </Border.Behaviors>
                <Label HorizontalOptions="Center" Text="Click to Shake this Border" TextColor="Black" />
            </Border>

            <Border BackgroundColor="LightGreen" WidthRequest="260" HorizontalOptions="Center" Margin="0,30,0,0">
                <Border.Behaviors>
                    <mct:AnimationBehavior AnimateOnTap="True">
                        <mct:AnimationBehavior.AnimationType>
                            <mct:BounceAnimation />
                        </mct:AnimationBehavior.AnimationType>
                    </mct:AnimationBehavior>
                </Border.Behaviors>
                <Label HorizontalOptions="Center" Text="Click to Bounce this Border" TextColor="Black" />
            </Border>

            <Label Text="&#x2665;" FontSize="48" TextColor="Red" HorizontalOptions="Center">
                <Label.Behaviors>
                    <mct:AnimationBehavior AnimateOnTap="True">
                        <mct:AnimationBehavior.AnimationType>
                            <mct:HeartbeatAnimation />
                        </mct:AnimationBehavior.AnimationType>
                    </mct:AnimationBehavior>
                </Label.Behaviors>
            </Label>

            <Border BackgroundColor="LightGreen" WidthRequest="260" HorizontalOptions="Center">
                <Border.Behaviors>
                    <mct:AnimationBehavior AnimateOnTap="True">
                        <mct:AnimationBehavior.AnimationType>
                            <mct:RubberBandAnimation />
                        </mct:AnimationBehavior.AnimationType>
                    </mct:AnimationBehavior>
                </Border.Behaviors>
                <Label HorizontalOptions="Center" Text="Click to Rubber Band this Border" TextColor="Black" />
            </Border>

            <Border BackgroundColor="LightGreen" WidthRequest="260" HorizontalOptions="Center">
                <Border.Behaviors>
                    <mct:AnimationBehavior AnimateOnTap="True">
                        <mct:AnimationBehavior.AnimationType>
                            <mct:SwingAnimation />
                        </mct:AnimationBehavior.AnimationType>
                    </mct:AnimationBehavior>
                </Border.Behaviors>
                <Label HorizontalOptions="Center" Text="Click to Swing this Border" TextColor="Black" />
            </Border>

            <Border BackgroundColor="LightGreen" WidthRequest="260" HorizontalOptions="Center">
                <Border.Behaviors>
                    <mct:AnimationBehavior AnimateOnTap="True">
                        <mct:AnimationBehavior.AnimationType>
                            <mct:TadaAnimation MaximumScale="1.2" RotationAngle="5" />
                        </mct:AnimationBehavior.AnimationType>
                    </mct:AnimationBehavior>
                </Border.Behaviors>
                <Label HorizontalOptions="Center" Text="Click to Tada this Border (MaximumScale 1.2, RotationAngle 5)" TextColor="Black" />
            </Border>

            <Border BackgroundColor="LightGreen" WidthRequest="260" HorizontalOptions="Center">
                <Border.Behaviors>
                    <mct:AnimationBehavior AnimateOnTap="True">
                        <mct:AnimationBehavior.AnimationType>
                            <mct:WobbleAnimation />
                        </mct:AnimationBehavior.AnimationType>
                    </mct:AnimationBehavior>
                </Border.Behaviors>
                <Label HorizontalOptions="Center" Text="Click to Wobble this Border" TextColor="Black" />
            </Border>

            <!--  Shows how the AnimationBehavior will play nicely with already attached TapGestureRecognizers  -->
            <Label
                Margin="16,0"
                HorizontalOptions="Center"
                Text="Click this Label">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding AnimationCommand}" />
                </Label.GestureRecognizers>
                <Label.Behaviors>
                    <mct:AnimationBehavior AnimateOnTap="True">
                        <mct:AnimationBehavior.AnimationType>
                            <behaviorPages:SampleScaleAnimation Easing="{x:Static Easing.Linear}" Length="100" />
                        </mct:AnimationBehavior.AnimationType>
                    </mct:AnimationBehavior>
                </Label.Behaviors>
            </Label>

            <Border
                x:Name="AnimatedBorder"
                Margin="16,0"
                BackgroundColor="LightGreen">
                <Border.Behaviors>
                    <mct:AnimationBehavior
                        AnimateCommand="{Binding AnimateFromViewModelCommand}"
                        AnimateOnTap="True"
                        BindingContext="{Binding Path=BindingContext, Source={x:Reference AnimatedBorder}, x:DataType=Border}">
                        <mct:AnimationBehavior.AnimationType>
                            <mct:FadeAnimation Opacity="0.2" />
                        </mct:AnimationBehavior.AnimationType>
                    </mct:AnimationBehavior>
                </Border.Behaviors>
                <Label
                    HorizontalOptions="Center"
                    Text="Click Inside This Border"
                    TextColor="Black" />
            </Border>

            <Button Command="{Binding TriggerAnimationCommand}" Text="Animate the Border above" />
        </VerticalStackLayout>
    </ScrollView>
</pages:BasePage>