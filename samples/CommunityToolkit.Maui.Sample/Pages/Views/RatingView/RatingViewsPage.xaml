<pages:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:pages="clr-namespace:CommunityToolkit.Maui.Sample.Pages"
                xmlns:viewModels="clr-namespace:CommunityToolkit.Maui.Sample.ViewModels.Views"
                x:Class="CommunityToolkit.Maui.Sample.Pages.Views.RatingViewsPage"
                Title="RatingViews Page"
                x:TypeArguments="viewModels:RatingViewsViewModel"
                x:DataType="viewModels:RatingViewsViewModel">

    <ContentPage.Content>
        <ScrollView>
            <VerticalStackLayout Spacing="12">
                <Button Text="RatingView C# Page" Clicked="HandleRatingViewCsharpButtonClicked" />

                <Button Text="RatingView Showcase Page" Clicked="HandleRatingViewShowcaseButtonClicked" />

                <Button Text="RatingView XAML Page" Clicked="HandleRatingViewXamlButtonClicked" />
            </VerticalStackLayout>
        </ScrollView>
    </ContentPage.Content>

</pages:BasePage>