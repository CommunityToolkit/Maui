<pages:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:pages="clr-namespace:CommunityToolkit.Maui.Sample.Pages"
                xmlns:viewModels="clr-namespace:CommunityToolkit.Maui.Sample.ViewModels.Views"
                x:Class="CommunityToolkit.Maui.Sample.Pages.Views.MapsPage"
                Title="Maps Page"
                x:TypeArguments="viewModels:MapsViewModel"
                x:DataType="viewModels:MapsViewModel">

    <ContentPage.Content>
        <ScrollView>
            <VerticalStackLayout Spacing="12">
                <Button Text="Maps Basic Page" Clicked="HandleBasicMapsButtonClicked" />

                <Button Text="Maps Pins Page" Clicked="HandleMapsPinsButtonClicked" />
            </VerticalStackLayout>
        </ScrollView>
    </ContentPage.Content>

</pages:BasePage>