<pages:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:pages="clr-namespace:CommunityToolkit.Maui.Sample.Pages"
                xmlns:viewModels="clr-namespace:CommunityToolkit.Maui.Sample.ViewModels.Views"
                x:Class="CommunityToolkit.Maui.Sample.Pages.Views.MediaElementsPage"
                Title="MediaElements Page"
                x:TypeArguments="viewModels:MediaElementsViewModel"
                x:DataType="viewModels:MediaElementsViewModel">

    <ContentPage.Content>
        <ScrollView>
            <VerticalStackLayout Spacing="12">
                <Button Text="MediaElement" Clicked="HandleMediaElementButtonClicked" />

                <Button Text="MediaElement from Stream" Clicked="HandleMediaElementFromStreamButtonClicked" />

                <Button Text="MediaElement in a Multi-Window Application" Clicked="HandleMediaElementMultipleWindowsButtonClicked" />

                <Button Text="MediaElement in CarouselView" Clicked="HandleMediaElementCarouselViewButtonClicked" />

                <Button Text="MediaElement in CollectionView" Clicked="HandleMediaElementCollectionViewButtonClicked" />
            </VerticalStackLayout>
        </ScrollView>
    </ContentPage.Content>

</pages:BasePage>