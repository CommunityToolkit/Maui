<?xml version="1.0" encoding="utf-8" ?>

<Label
    x:Class="CommunityToolkit.Maui.Sample.Views.NullableBoolComponentWithLabel"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:CommunityToolkit.Maui.Sample.Views"
    IsVisible="{Binding NullableIsVisible, Source={x:RelativeSource Self}, x:DataType=views:NullableBoolComponentWithLabel}"
    Text="The converter's result can also be bound to a nullable bool (bool?). This label shows only while the result is true."
    TextColor="{StaticResource NormalLabelTextColor}"
    VerticalOptions="Center" />